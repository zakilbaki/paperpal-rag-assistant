# Docker Compose works without this file. Copy it to .env only to override defaults.
MONGODB_URI=mongodb://mongo:27017
MONGODB_DB=paperpal_db
FRONTEND_ORIGIN=http://localhost:8501
BACKEND_BASE_URL=http://localhost:8000
SUMMARIZATION_MODEL_NAME=sshleifer/distilbart-cnn-6-6
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
CHROMA_PATH=.chroma
CHROMA_COLLECTION=paperpal_chunks_v1
RAG_CONTEXT_MAX_TOKENS=1200
RAG_CONTEXT_MAX_PASSAGES=5
